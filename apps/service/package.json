{
  "name": "@katasu.me/service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && vite preview",
    "prepare": "panda codegen",
    "cf-typegen": "wrangler types",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:generate": "drizzle-kit generate --dialect sqlite --out ../../packages/service-db/src/migrations --schema ../../packages/service-db/src/schema",
    "db:studio": "dotenvx run -f .env.local -- drizzle-kit studio",
    "db:migrate": "wrangler d1 migrations apply katasu-me-dev --local",
    "db:migrate:dev": "wrangler d1 migrations apply katasu-me-dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply katasu-me --remote --env production",
    "db:push": "wrangler d1 execute katasu-me-dev --local --file=$(ls ../../packages/service-db/src/migrations/*.sql | fzf)",
    "db:push:dev": "wrangler d1 execute katasu-me-dev --remote --file=$(ls ../../packages/service-db/src/migrations/*.sql | fzf)",
    "db:push:prod": "wrangler d1 execute katasu-me --remote --file=$(ls ../../packages/service-db/src/migrations/*.sql | fzf) --env production",
    "db:seed": "wrangler d1 execute katasu-me-dev --local --file=../../packages/service-db/src/seeds/plans.sql",
    "db:seed:dev": "wrangler d1 execute katasu-me-dev --file=../../packages/service-db/src/seeds/plans.sql",
    "db:seed:prod": "wrangler d1 execute katasu-me --remote --file=../../packages/service-db/src/seeds/plans.sql --env production"
  },
  "dependencies": {
    "@arrow2nd/vaul": "^1.1.7",
    "@cloudflare/vite-plugin": "^1.63.0",
    "@katasu.me/service-db": "workspace:*",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.42",
    "better-auth": "^1.7.7",
    "budoux": "^0.8.4",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.45.2",
    "image-size": "^2.0.4",
    "motion": "^12.23.24",
    "nanoid": "^5.1.16",
    "openai": "^6.49.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "thumbhash": "^0.1.1",
    "valibot": "^1.2.0",
    "wasm-image-optimization": "^1.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@dotenvx/dotenvx": "^1.51.1",
    "@fontsource-variable/reddit-sans": "^5.2.7",
    "@fontsource/ibm-plex-sans-jp": "^5.2.8",
    "@pandacss/dev": "^1.12.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.11",
    "baseline-browser-mapping": "^2.9.19",
    "better-sqlite3": "^12.5.0",
    "happy-dom": "^20.14.5",
    "storybook": "^10.6.1",
    "storybook-addon-pseudo-states": "^10.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11",
    "web-vitals": "^5.1.0",
    "wrangler": "^4.148.0"
  }
}
